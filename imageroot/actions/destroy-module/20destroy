import os
import sys
import agent
import sympa_mail

mail_server = os.environ.get("RELAY_MAIL_SERVER") or os.environ.get("MAIL_SERVER")
if mail_server:
    # The instance must go away even if the mail module is unreachable
    try:
        sympa_mail.remove_addresses(mail_server)
    except Exception as ex:
        print(agent.SD_WARNING + f"Cannot remove the mail addresses: {ex}", file=sys.stderr)
    try:
        sympa_mail.remove_relay_rule(mail_server)
    except Exception as ex:
        print(agent.SD_WARNING + f"Cannot remove the relay rule: {ex}", file=sys.stderr)
