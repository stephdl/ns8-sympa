import os
import sys
import agent
import sympa_mail

if os.environ.get("MAIL_SERVER"):
    try:
        sympa_mail.remove_relay_rule(os.environ["MAIL_SERVER"])
    except Exception as ex:
        # The instance must go away even if the mail module is unreachable
        print(agent.SD_WARNING + f"Cannot remove the relay rule: {ex}", file=sys.stderr)
