import os
import sys
import json
import subprocess
import agent
import sympa_mail

request = json.load(sys.stdin)

# The copied environment holds the source node address and port
sympa_mail.set_smtp_endpoint(agent.redis_connect(use_replica=True))

# The source instance keeps its route and its relay rule: a copy has neither
if not request.get("replace"):
    # A copy must not take over the relay rule of the source: give it its own inbound domain
    agent.set_env("INBOUND_DOMAIN", os.environ["MODULE_ID"] + ".invalid")
    subprocess.run(["systemctl", "--user", "try-restart", "sympa.service"], check=True)
    print(agent.SD_WARNING + "Cloned instance has no web route and no mail relay, set a new host name in Settings", file=sys.stderr)
    sys.exit(0)

# A move: the new instance takes over the route and the relay rule of the source.
# create-module already set INBOUND_DOMAIN, so the core did not import the source
# value. Restore it: the addresses declared in the mail module point to it.
source_env = agent.read_envfile('environment.clone-module')
agent.set_env("INBOUND_DOMAIN", source_env["INBOUND_DOMAIN"])

rdb = agent.redis_connect(use_replica=True)
source_route = {}
for module_id, uuid in rdb.hgetall('cluster/module_uuid').items():
    if uuid == os.environ['MODULE_UUID'] and module_id != os.environ['MODULE_ID']:
        source_route = agent.get_route(module_id) or {}

configure_retval = agent.tasks.run(agent_id=os.environ['AGENT_ID'], action='configure-module', data={
    "host": os.environ["TRAEFIK_HOST"],
    "lets_encrypt": source_route.get('lets_encrypt', False),
    "list_domain": os.environ["LIST_DOMAIN"],
    "listmasters": [addr for addr in os.environ["LISTMASTERS"].split(",") if addr],
    "mail_server": os.environ["MAIL_SERVER"],
    "user_domain": os.environ.get("USER_DOMAIN", ""),
    "default_lang": os.environ.get("DEFAULT_LANG", "en-US"),
})
agent.assert_exp(configure_retval['exit_code'] == 0, "The configure-module subtask failed!")
