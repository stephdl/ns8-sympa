import sys
import json
import agent

request = json.load(sys.stdin)
original_environment = request['environment']

for evar in [
        "TRAEFIK_HOST",
        "LIST_DOMAIN",
        "LISTMASTERS",
        "MAIL_SERVER",
        "USER_DOMAIN",
        "DEFAULT_LANG",
        # Keep the inbound domain: the addresses in the mail module point to it
        "INBOUND_DOMAIN",
    ]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])
