set -e -o pipefail
exec 1>&2

mkdir -vp restore
mv -v sympa.pg_dump restore/
cat - >restore/zz_sympa_restore.sh <<'EOS'
pg_restore --no-owner --no-privileges -U sympa -d sympa /restore/sympa.pg_dump
ec=$?
docker_temp_server_stop
exit $ec
EOS

podman run \
    --rm \
    --network=none \
    --volume=./restore:/restore:Z \
    --volume=./restore/zz_sympa_restore.sh:/docker-entrypoint-initdb.d/zz_sympa_restore.sh:Z \
    --volume=postgres-data:/var/lib/postgresql:Z \
    --env-file=secrets/postgres.env \
    --env POSTGRES_USER=sympa \
    --env POSTGRES_DB=sympa \
    --env TZ=UTC \
    --replace --name=restore_db \
    "${POSTGRES_IMAGE}"

rm -rf restore
