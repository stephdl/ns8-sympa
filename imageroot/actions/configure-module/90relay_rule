import os
import sympa_mail

previous = os.environ.get("PREVIOUS_MAIL_SERVER", "")
current = os.environ["MAIL_SERVER"]

if previous and previous != current:
    sympa_mail.remove_relay_rule(previous)

sympa_mail.ensure_relay_rule(current)
