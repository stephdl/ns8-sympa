import os
import sys
import json
import agent
import sympa_mail
import sympa_lists
from agent.ldapproxy import Ldapproxy

# Validation step, no task progress at all
agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)
errors = []


def fail(field, value, error):
    errors.append({'field': field, 'parameter': field, 'value': value, 'error': error})


rdb = agent.redis_connect(use_replica=True)


def route_owned_by_us(host):
    """True if the route belongs to this instance, or to the source of a move (same UUID)"""
    owners = [os.environ['MODULE_ID']]
    for module_id, uuid in rdb.hgetall('cluster/module_uuid').items():
        if uuid == os.environ['MODULE_UUID'] and module_id not in owners:
            owners.append(module_id)
    return any((agent.get_route(module_id) or {}).get('host') == host for module_id in owners)


host = data["host"].lower()
# A copy keeps the source host but has no route: it must not take the source route
if agent.http_route_in_use(domain=host) and not route_owned_by_us(host):
    fail('host', host, 'domain_already_used_in_traefik')

providers = agent.list_service_providers(rdb, 'imap', 'tcp', {'module_uuid': data["mail_server"]})
if not providers:
    fail('mail_server', data["mail_server"], 'mail_server_not_found')
else:
    # The mail module rejects its internal LDAP domain and every subdomain of it
    internal = providers[0].get('user_domain', '').lower()
    list_domain = data["list_domain"].lower()
    in_use = sympa_mail.list_domains_in_use(rdb)
    if internal and (list_domain == internal or list_domain.endswith('.' + internal)):
        fail('list_domain', data["list_domain"], 'list_domain_is_mail_internal_domain')
    elif list_domain in in_use:
        fail('list_domain', data["list_domain"], 'list_domain_used_by_another_instance')
    else:
        result = agent.tasks.run(f"module/{providers[0]['module_id']}", action='list-domains', data={})
        agent.assert_exp(result['exit_code'] == 0, "Cannot list the domains of the mail server")
        if list_domain not in [record['domain'].lower() for record in result['output']]:
            fail('list_domain', data["list_domain"], 'list_domain_not_in_mail_server')

# The lists and their subscribers are stored under the list domain: changing it hides them
if os.environ.get("LIST_DOMAIN") and sympa_lists.count_lists():
    if data["list_domain"].lower() != os.environ["LIST_DOMAIN"].lower():
        fail('list_domain', data["list_domain"], 'list_domain_locked')
    if data["mail_server"] != os.environ.get("MAIL_SERVER"):
        fail('mail_server', data["mail_server"], 'mail_server_locked')

user_domain = data.get("user_domain", "")
if user_domain and user_domain not in Ldapproxy().get_domains_list():
    fail('user_domain', user_domain, 'user_domain_not_found')

if errors:
    agent.set_status('validation-failed')
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
