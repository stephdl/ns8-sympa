import os
import secrets
import agent


def write_secret(path, lines):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fp:
        fp.write("\n".join(lines) + "\n")


os.makedirs("secrets", mode=0o700, exist_ok=True)

db_password = secrets.token_urlsafe(32)
write_secret("secrets/postgres.env", [f"POSTGRES_PASSWORD={db_password}"])
write_secret("secrets/sympa.env", [
    f"SYMPA_DB_PASSWORD={db_password}",
    f"SYMPA_COOKIE={secrets.token_hex(32)}",
])

# The mail module forwards list addresses to <local>@<INBOUND_DOMAIN>. The
# reserved .invalid TLD never resolves, and the value survives restore and
# move so the addresses declared in the mail module stay valid.
agent.set_env("INBOUND_DOMAIN", os.environ["MODULE_ID"] + ".invalid")
