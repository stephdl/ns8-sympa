#
# The module cannot read the addresses of the mail module: the UI checks
# them with the token of the logged admin
#

import os
import sys
import json
import sympa_lists
import sympa_mail

domain = os.environ.get("LIST_DOMAIN", "")
configured = bool(domain and os.environ.get("MAIL_SERVER"))

json.dump({
    "configured": configured,
    "lists": sympa_lists.get_lists(domain) if configured else [],
    "list_types": sympa_lists.LIST_TYPES,
    "robot_addresses": sympa_mail.robot_local_parts() if configured else [],
    "list_suffixes": sympa_mail.LIST_SUFFIXES,
}, fp=sys.stdout)
