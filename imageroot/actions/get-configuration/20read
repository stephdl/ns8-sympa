import os
import sys
import json
import agent
import sympa_mail
import sympa_lists
from agent.ldapproxy import Ldapproxy

rdb = agent.redis_connect(use_replica=True)



def list_mail_domains(module_id, internal):
    """Domains of the mail module that can receive list mail"""
    try:
        result = agent.tasks.run(f"module/{module_id}", action='list-domains', data={})
    except Exception as ex:
        print(agent.SD_WARNING + f"Cannot list the domains of {module_id}: {ex}", file=sys.stderr)
        return []
    if result['exit_code'] != 0:
        print(agent.SD_WARNING + f"Cannot list the domains of {module_id}", file=sys.stderr)
        return []
    domains = []
    for record in result['output']:
        domain = record['domain'].lower()
        # The mail module rejects its internal domain and every subdomain of it
        if domain == '*' or (internal and (domain == internal or domain.endswith('.' + internal))):
            continue
        domains.append(domain)
    return sorted(domains)


mail_servers = []
for provider in agent.list_service_providers(rdb, 'imap', 'tcp'):
    internal = provider.get("user_domain", "").lower()
    mail_servers.append({
        "uuid": provider["module_uuid"],
        "module_id": provider["module_id"],
        "ui_name": provider.get("ui_name") or "",
        "node": provider["node"],
        "internal_domain": internal,
        "domains": list_mail_domains(provider["module_id"], internal),
    })

route = agent.get_route(os.environ['MODULE_ID']) or {}
smarthost = agent.get_smarthost_settings(rdb)
inbound = os.environ.get("INBOUND_DOMAIN", "")

config = {
    "host": os.getenv("TRAEFIK_HOST", ""),
    "lets_encrypt": route.get('lets_encrypt', False),
    "has_route": bool(route),
    "list_domain": os.getenv("LIST_DOMAIN", ""),
    "listmasters": [addr for addr in os.getenv("LISTMASTERS", "").split(",") if addr],
    "mail_server": os.getenv("MAIL_SERVER", ""),
    "user_domain": os.getenv("USER_DOMAIN", ""),
    "default_lang": os.getenv("DEFAULT_LANG", "en-US"),
    "inbound_domain": inbound,
    "mail_servers": mail_servers,
    "user_domains": Ldapproxy().get_domains_list(),
    "smarthost_enabled": bool(smarthost["enabled"] and smarthost["host"]),
    # Domains already served by another Sympa instance, with its module ID
    "domains_in_use": sympa_mail.list_domains_in_use(rdb),
    "lists_count": sympa_lists.count_lists(),
}
json.dump(config, fp=sys.stdout)
