{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://nethserver.org/json-schema/task/input/sympa/create-list-addresses",
    "title": "create-list-addresses input",
    "description": "Create the missing mail addresses of an existing list",
    "examples": [
        {
            "name": "news"
        }
    ],
    "type": "object",
    "required": [
        "name"
    ],
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string",
            "title": "List name",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
        }
    }
}
