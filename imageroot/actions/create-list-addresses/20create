#
# Create the missing addresses of a list made in the Sympa web interface
#

import os
import sys
import json
import agent
import sympa_lists
import sympa_mail

request = json.load(sys.stdin)
name = request['name'].lower()
domain = os.environ["LIST_DOMAIN"]


def fail(error, value):
    agent.set_status('validation-failed')
    json.dump([{'field': 'name', 'parameter': 'name', 'value': value, 'error': error}], fp=sys.stdout)
    sys.exit(2)


if not sympa_lists.list_exists(name, domain):
    fail('list_not_found', name)
try:
    created = sympa_mail.add_addresses(os.environ["MAIL_SERVER"], domain, sympa_mail.list_local_parts(name))
except sympa_mail.AddressError as ex:
    detail = ex.details[0] if ex.details else {}
    fail('list_' + detail.get('error', 'cannot_create_addresses'), detail.get('value', name))

json.dump({"name": name, "created": created}, fp=sys.stdout)
