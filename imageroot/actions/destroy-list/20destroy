#
# The UI removes the mail addresses of the list after this action
#

import os
import sys
import json
import agent
import sympa_lists

request = json.load(sys.stdin)
name = request['name'].lower()
domain = os.environ["LIST_DOMAIN"]

if not sympa_lists.list_exists(name, domain):
    agent.set_status('validation-failed')
    json.dump([{'field': 'name', 'parameter': 'name', 'value': name, 'error': 'list_not_found'}], fp=sys.stdout)
    sys.exit(2)

ok, message = sympa_lists.purge_list(name, domain)
if not ok:
    print(agent.SD_ERR + f"sympa close failed: {message}", file=sys.stderr)
    sys.exit(1)

json.dump({"name": name}, fp=sys.stdout)
