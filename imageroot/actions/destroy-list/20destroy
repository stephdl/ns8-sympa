import os
import sys
import json
import agent
import sympa_lists
import sympa_mail

request = json.load(sys.stdin)
name = request['name'].lower()
domain = os.environ["LIST_DOMAIN"]

if not sympa_lists.list_exists(name, domain):
    agent.set_status('validation-failed')
    json.dump([{'field': 'name', 'parameter': 'name', 'value': name, 'error': 'list_not_found'}], fp=sys.stdout)
    sys.exit(2)

ok, message = sympa_lists.purge_list(name, domain)
if not ok:
    print(agent.SD_ERR + f"sympa close failed: {message}", file=sys.stderr)
    sys.exit(1)

# Only addresses owned by this instance are removed, others stay untouched
removed = sympa_mail.remove_addresses(os.environ["MAIL_SERVER"], domain, sympa_mail.list_local_parts(name))
json.dump({"name": name, "removed_addresses": len(removed)}, fp=sys.stdout)
