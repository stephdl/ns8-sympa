import os
import sys
import json
import subprocess

event = json.load(sys.stdin)
# "domains" exists since core 3.16, "domain" is the obsolete form
changed = event.get("domains") or [event.get("domain")]
if os.environ.get("USER_DOMAIN") not in changed:
    sys.exit(0)

subprocess.run(["systemctl", "--user", "try-restart", "sympa.service"], check=True)
