#
# Generate the environment files read by the Sympa containers, from the
# module environment, the cluster smarthost and the bound user domain.
# Run before the pod starts, so every restart picks up the current values.
#

import os
import sys
import agent
from agent.ldapproxy import Ldapproxy

# Inside the pod, 10.0.2.2 is the node loopback (slirp4netns allow_host_loopback)
NODE_LOOPBACK = "10.0.2.2"


def write_env(path, values, secret=False):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600 if secret else 0o644)
    with os.fdopen(fd, "w") as fp:
        for key, value in values.items():
            # podman --env-file reads one KEY=VALUE per line, a newline would split the value
            fp.write(f"{key}={str(value).replace(chr(10), '')}\n")
    os.replace(tmp, path)


env = os.environ
host = env.get("TRAEFIK_HOST", "")

write_env("sympa.env", {
    "SYMPA_DOMAIN": env.get("LIST_DOMAIN", ""),
    "SYMPA_LISTMASTERS": env.get("LISTMASTERS", ""),
    "SYMPA_WWSYMPA_URL": f"https://{host}/sympa",
    "SYMPA_HOSTNAME": host,
    "SYMPA_INBOUND_DOMAIN": env.get("INBOUND_DOMAIN", ""),
    "SYMPA_LANG": env.get("DEFAULT_LANG", "en-US"),
})

os.makedirs("secrets", mode=0o700, exist_ok=True)

ldap = {}
user_domain = env.get("USER_DOMAIN", "")
if user_domain:
    try:
        lp = Ldapproxy()
        domain = lp.get_domain(user_domain)
        ldap = {
            "SYMPA_LDAP_HOST": "accountprovider",
            "SYMPA_LDAP_PORT": domain["port"],
            "SYMPA_LDAP_BASE": domain["base_dn"],
            "SYMPA_LDAP_BIND_DN": domain["bind_dn"],
            "SYMPA_LDAP_BIND_PASSWORD": domain["bind_password"],
            "SYMPA_LDAP_SCHEMA": domain["schema"],
            "SYMPA_LDAP_USER_CLAUSE": lp.get_ldap_users_search_filter_clause(user_domain),
        }
    except Exception as ex:
        # Local Sympa accounts keep working without the user domain
        print(agent.SD_WARNING + f"User domain {user_domain} is not available, LDAP login disabled: {ex}", file=sys.stderr)
write_env("secrets/ldap.env", ldap, secret=True)

rdb = agent.redis_connect(use_replica=True)
smtp = agent.get_smarthost_settings(rdb)
smarthost = {}
if smtp["enabled"] and smtp["host"]:
    local_smtp = smtp["host"] in ("127.0.0.1", "localhost", "::1")
    smarthost = {
        "SMTP_ENABLED": "1",
        "SMTP_HOST": NODE_LOOPBACK if local_smtp else smtp["host"],
        "SMTP_PORT": smtp["port"],
        "SMTP_USERNAME": smtp["username"],
        "SMTP_PASSWORD": smtp["password"],
        "SMTP_ENCRYPTION": smtp["encrypt_smtp"],
        # The local certificate never matches 10.0.2.2
        "SMTP_TLSVERIFY": "1" if smtp["tls_verify"] and not local_smtp else "",
    }
else:
    print(agent.SD_WARNING + "The cluster smarthost is not configured, outgoing mail stays in the queue", file=sys.stderr)
write_env("secrets/smarthost.env", smarthost, secret=True)
