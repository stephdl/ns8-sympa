[Unit]
Description=Podman postgresql-app.service
BindsTo=sympa.service
After=sympa.service
Before=sympa-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/postgresql-app.pid %t/postgresql-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/postgresql-app.pid \
    --cidfile %t/postgresql-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/sympa.pod-id --replace -d --name postgresql-app \
    --volume postgres-data:/var/lib/postgresql:Z \
    --env-file=%S/state/secrets/postgres.env \
    --env POSTGRES_USER=sympa \
    --env POSTGRES_DB=sympa \
    --env TZ=UTC \
    ${POSTGRES_IMAGE}
ExecStartPost=/usr/bin/podman exec postgresql-app /bin/sh -c 'until pg_isready -h 127.0.0.1 -U sympa -d sympa -q; do sleep 1; done'
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/postgresql-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/postgresql-app.ctr-id
PIDFile=%t/postgresql-app.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
