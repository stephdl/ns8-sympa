{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:ns8-automerge"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump Containerfile *_VERSION args annotated with a `# renovate:` comment",
      "managerFilePatterns": [
        "/(^|/)Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) packageName=(?<packageName>\\S+) versioning=(?<versioning>\\S+)\\s*\\nARG \\w+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Repology has no release timestamps, and a Sympa upgrade migrates live data on start",
      "matchDatasources": [
        "repology"
      ],
      "matchPackageNames": [
        "epel_9/sympa"
      ],
      "minimumReleaseAge": null,
      "automerge": false
    }
  ]
}
