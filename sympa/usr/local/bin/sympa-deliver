#!/bin/bash

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Postfix pipe target. The mail module forwards <local>@<module_id>, and
# this script hands the message to the Sympa queue for <local>@<list domain>.
# It replaces the sympa_transport map: the addresses live in the mail module.
#

local_part="${1,,}"
domain=$(sed -n 's/^domain[[:space:]]\+//p' /etc/sympa/sympa.conf)
# Robot addresses start with the instance prefix, see SYMPA_ROBOT_PREFIX
robot=$(sed -n 's/^email[[:space:]]\+//p' /etc/sympa/sympa.conf)
# EX_TEMPFAIL: Postfix keeps the message and retries
[[ -n "${local_part}" && -n "${domain}" && -n "${robot}" ]] || exit 75

case "${local_part}" in
"${robot}-bounce"|"${robot}-abuse-feedback-report")
    exec /usr/libexec/sympa/bouncequeue "${robot}@${domain}"
    ;;
"${robot}"|"${robot}-listmaster")
    exec /usr/libexec/sympa/queue "${local_part}@${domain}"
    ;;
"${robot}-request"|"${robot}-owner")
    exec /usr/libexec/sympa/queue "${robot}-listmaster@${domain}"
    ;;
*-owner)
    exec /usr/libexec/sympa/bouncequeue "${local_part%-owner}@${domain}"
    ;;
*)
    exec /usr/libexec/sympa/queue "${local_part}@${domain}"
    ;;
esac
